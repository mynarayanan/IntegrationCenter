# Public browser-safe Supabase values. Never place the service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Demo mode is for local evaluation only. Set false or omit in deployed environments.
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_APP_NAME=Integration Centre

# Optional, server-only trusted worker credentials. Never expose this value publicly.
SUPABASE_SERVICE_ROLE_KEY=
